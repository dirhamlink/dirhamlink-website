NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-sb-publishable-key

# Telegram customer-support bot (keep these server-side; never use NEXT_PUBLIC_)
TELEGRAM_BOT_TOKEN=your-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-secret
TELEGRAM_SETUP_SECRET=generate-another-long-random-secret

# Server-only Supabase admin key (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transactional email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=DirhamLink <notifications@your-verified-domain.com>

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_COMPLETION_TEMPLATE_NAME=dirhamlink_transfer_completed
WHATSAPP_COMPLETION_TEMPLATE_LANGUAGE=en
# Optional; defaults to v23.0
WHATSAPP_GRAPH_API_VERSION=v23.0
